# Copy this file to .env and fill in the empty values. Never commit .env.

# Generate with the command below. Avoid keys containing "$": Docker Compose also reads
# this file and would treat "$..." as a variable to substitute.
# .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Read by both Django and the PostgreSQL container (compose.yaml).
POSTGRES_DB=prenotazioni
POSTGRES_USER=prenotazioni
POSTGRES_PASSWORD=
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and can hang.
POSTGRES_HOST=127.0.0.1
# 5433 avoids clashing with a PostgreSQL installed directly on the PC.
POSTGRES_PORT=5433
